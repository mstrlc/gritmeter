// Cloudflare Workers config: serve site/ as static assets; src/worker.js runs first to redirect www to the apex.
{
  "name": "gritmeter",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // custom domains: wrangler creates the DNS records and certificates on deploy
  "routes": [
    { "pattern": "gritmeter.app", "custom_domain": true },
    { "pattern": "www.gritmeter.app", "custom_domain": true }
  ]
}
